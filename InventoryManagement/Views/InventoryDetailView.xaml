<Window x:Class="InventoryManagement.Views.InventoryDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:InventoryManagement.Views"
        mc:Ignorable="d"
        Title="InventoryDetailView" Height="450" Width="800" d:DataContext="{d:DesignInstance }">
    <Grid>
        <StackPanel Margin="20">

            <TextBox Text="{Binding ProductName}" />
            <TextBox Text="{Binding CategoryName}" />
            <TextBox Text="{Binding Price}" />
            <TextBox Text="{Binding Stock}" />
        </StackPanel>
    </Grid>
</Window>
